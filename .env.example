# Chaves da API da Groq usadas pelo backend (Sistema de IA do SAEI).
# Copie este arquivo para .env e preencha com as suas chaves:
#   cp .env.example .env
#
# GROQ_API_KEY  = chave primária
# GROQ_API_KEY_B = chave reserva ("plano B"): é usada automaticamente se a primária falhar.
# Se a primária estiver funcionando, a reserva não é tocada.
GROQ_API_KEY=
GROQ_API_KEY_B=
